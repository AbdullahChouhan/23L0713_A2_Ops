# Task 6.4 Baseline (Unoptimized) Dockerfile for Before/After Image Size Comparison
FROM python:3.11

WORKDIR /app

COPY requirements-prod.txt ./
RUN pip install -r requirements-prod.txt

COPY app/ ./app/
COPY models/champion_model.keras ./models/champion_model.keras

EXPOSE 5000
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "app.main:app"]
